{
  "name": "syntee-helper",
  "version": "1.0.9",
  "description": "Syntee Helper — персональный AI-ассистент для Windows",
  "main": "./out/main/index.js",
  "author": "Syntee",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc -b",
    "typecheck:updates": "tsc -p tsconfig.updates-check.json",
    "build": "npm run typecheck:updates && electron-vite build",
    "start": "electron-vite build && electron out/main/index.js",
    "preview": "electron-vite preview",
    "build:win": "npm run build && electron-builder --win",
    "lint": "eslint . --format json",
    "lint:pretty": "eslint .",
    "postinstall": "electron-builder install-app-deps && npm rebuild better-sqlite3 --runtime=electron --target=36.0.0 --dist-url=https://electronjs.org/headers && node scripts/copy-tree-sitter-wasms.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-force": "^3.0.10",
    "@types/diff": "^7.0.2",
    "@types/ws": "^8.18.1",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "diff": "^9.0.0",
    "electron-store": "^8.2.0",
    "framer-motion": "^11.18.2",
    "js-tiktoken": "^1.0.21",
    "jsonrepair": "^3.15.0",
    "katex": "^0.17.0",
    "lucide-react": "^0.511.0",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "openai": "^4.100.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "uuid": "^10.0.0",
    "web-tree-sitter": "^0.24.0",
    "ws": "^8.21.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^20.17.50",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^36.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "javascript-obfuscator": "^5.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.19",
    "vite-plugin-monaco-editor": "^1.1.0"
  }
}
